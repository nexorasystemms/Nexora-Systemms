# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix with NEXT_PUBLIC_, never commit it, never expose it to the client.
# Used only in src/lib/supabase/admin.ts for staff-invite (auth.admin) actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin/super-admin login code email (src/lib/email/send.ts). Gmail is tried first if both
# GMAIL_ vars are set (works for any recipient, no domain needed); custom SMTP is the fallback.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Custom email configuration for your domain (Namecheap/Zoho/etc)
CUSTOM_SMTP_HOST=smtp.zoho.com
CUSTOM_SMTP_PORT=587
CUSTOM_SMTP_USER=noreply@yourdomain.com
CUSTOM_SMTP_PASSWORD=your-email-password
CUSTOM_SMTP_FROM=Nexora Systems <noreply@yourdomain.com>
