NODE_ENV=development
PORT=4000
# Browser origins allowed to call this service (the TMU web app), comma-separated
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Document reading (autofill) ---
# anthropic | openai | ollama
AI_PROVIDER=anthropic
# Optional; defaults: anthropic=claude-sonnet-5-5, openai=gpt-4o, ollama=qwen3:14b
AI_MODEL=
# Ollama only: model used for photos/scans (qwen3 is text-only and cannot read images)
AI_VISION_MODEL=qwen2.5vl:7b
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key

# --- TMU Supabase project ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
# Server-side only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Set to false ONLY for local testing without Supabase
NEXORA_REQUIRE_AUTH=true
