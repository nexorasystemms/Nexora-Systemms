# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix with NEXT_PUBLIC_, never commit it, never expose it to the client.
# Used only in src/lib/supabase/admin.ts for staff-invite (auth.admin) actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
