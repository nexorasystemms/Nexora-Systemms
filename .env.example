VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Local FTP deploy (npm run deploy:ftp) — never commit real passwords
# NAMECHEAP_FTP_SERVER=ftp.yourdomain.com
# NAMECHEAP_FTP_USERNAME=cpanel_user
# NAMECHEAP_FTP_PASSWORD=
# NAMECHEAP_FTP_SERVER_DIR=/public_html/
# NAMECHEAP_FTP_PORT=21
# NAMECHEAP_FTP_SECURE=1
# Optional if TLS still complains: NAMECHEAP_FTP_TLS_SERVERNAME=premium166-2.web-hosting.com



# Nexora automation service (document autofill + automated assessment)
VITE_NEXORA_API_URL=http://localhost:4000
