# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix with NEXT_PUBLIC_, never commit it, never expose it to the client.
# Used in src/lib/supabase/admin.ts for staff-invite actions AND for minting admin login codes
# (src/app/login/actions.ts) via auth.admin.generateLink().
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin/super-admin login code email (src/lib/email/send.ts) — set ONE of these two options.
#
# Option A: Gmail SMTP. No domain needed at all (this is why it's the default pick when both
# are set — see send.ts) and can email any recipient. GMAIL_APP_PASSWORD is a Google Account
# "App Password", NOT your normal Gmail password: needs 2-Step Verification turned on first,
# then Google Account -> Security -> 2-Step Verification -> App passwords -> generate one for
# "Mail". Paste the 16-character result here with no spaces.
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Option B: Resend. Free at https://resend.com (no card required). Works immediately from the
# shared onboarding@resend.dev address, BUT that address can only deliver TO the email on your
# own Resend account — fine to test with, not enough once there's more than one admin. Verify
# a real domain (Resend dashboard -> Domains) and set RESEND_FROM_EMAIL once Nexora has one.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Nexora Systems <onboarding@resend.dev>
